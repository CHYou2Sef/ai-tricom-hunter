# ╔══════════════════════════════════════════════════════════════════════╗
# ║  AI Tricom Hunter — Production Environment (V6 — GOLDEN-TIERS)        ║
# ║  Optimized for: Windows Host (HDD) + Docker Linux Container          ║
# ║  Active Waterfall: [Tier2 → Tier6] + Scrapy Sniper                  ║
# ║  Tiers: 2=SeleniumBase UC  6=Crawl4AI (no intermediate tiers)        ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── 🏗️ INFRASTRUCTURE & PATHS ──────────────────────────────────────────
# HOST_WORK_DIR: Absolute path on your WINDOWS machine (e.g. C:/Data/AI_Hunter/WORK)
# This folder will be "teleported" into the container's /app/WORK
HOST_WORK_DIR=./WORK
HOST_LOG_DIR=./logs

# Inside Docker, leave these as defaults (/app/WORK, /app/logs)
WORK_DIR=/app/WORK
LOG_DIR=/app/logs

# ── 🏎️ HARDWARE OPTIMIZATION (Crucial for HDD/8GB RAM Windows host) ───
# Save frequency (total rows processed before writing to HDD).
# Higher = Less HDD stress, but more RAM usage. 50-100 is best for HDDs.
SAVE_INTERVAL=50

# Max workers. On 8GB RAM, strictly keep at 1 or 2.
MAX_CONCURRENT_WORKERS=1

# ── 🌐 GOLDEN-TIERS: ACTIVE BROWSER TIERS ─────────────────────────────
# PERFORMANCE_MODE=golden activates tier_sequence = [2, 6]
#   2 → SeleniumBase UC  (PRIMARY ⭐) — fastest, lowest RAM
#   6 → Crawl4AI         (Managed JS rendering) — fallback only
# No intermediate tiers (Botasaurus, CloakBrowser, Nodriver, Firecrawl, Crawlee)
PERFORMANCE_MODE=golden
MAX_WATERFALL_TIER=6

# Default entry tier (SeleniumBase UC)
HYBRID_DEFAULT_TIER=2

# ── 🌐 NETWORK SPEED DIAL ───────────────────────────────────────────
# Controls HTTP timeout budgets across all browser tiers.
# NETWORK_SPEED_MODE is a human-friendly dial (overrides NETWORK_SPEED_MULTIPLIER):
#   fast      = 0.5x timeouts  (for fiber/cable, Google responds < 100ms)
#   normal    = 1.0x timeouts  (default)
#   slow      = 1.5x timeouts  (for ADSL, Satellite, or high-latency connections)
#   very_slow = 2.5x timeouts  (last resort for very slow/unreliable links)
NETWORK_SPEED_MODE=normal
# NETWORK_SPEED_MULTIPLIER is also available as a raw float (takes precedence if NETWORK_SPEED_MODE is unset)
# NETWORK_SPEED_MULTIPLIER=1.0
NETWORK_SPEED_PROBE_ON_STARTUP=true

# ── ✅ ACTIVE TIERS ────────────────────────────────────────────────────
SELENIUMBASE_ENABLED=true
CLOAKBROWSER_ENABLED=false

# ── ❌ DISABLED TIERS (save RAM, disk, and build time) ─────────────────
# Tier 0: Legacy Selenium + undetected-chromedriver (benchmark only)
SELENIUM_ENABLED=false

# Tier 7: Camoufox Firefox (~1 GB RAM, not needed with full golden path)
CAMOUFOX_ENABLED=false

# Tier 8: Firecrawl (requires paid API key — disabled by default)
FIRECRAWL_ENABLED=false
# FIRECRAWL_API_KEY=your_key_here

# Tier 9: Jina Reader (enabled on-demand via Layer 2 direct calls only)
JINA_ENABLED=false
# JINA_API_KEY=

# Tier 10: Crawlee Industrial (not needed — Scrapy Sniper handles post-discovery)
CRAWLEE_ENABLED=false

# ── 🗝️ CREDENTIALS & API KEYS ───────────────────────────────────────────
# Optional: CAPTCHA Auto-Solver (2captcha | capsolver | manual)
CAPTCHA_SOLVER=manual
CAPTCHA_API_KEY=

# Neutrino Phone Validation (Phase 5)
NEUTRINO_ENABLED=true
# NEUTRINO_USER_ID=your_user_id
# NEUTRINO_API_KEY=your_api_key

# ── 🤖 AI SEARCH & LLM LOGIC ────────────────────────────────────────────
PROMPT_STYLE=caveman

# Local LLM (Ollama) — runs on Windows host, accessible from Docker
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=60

# ── 🔗 LAYER PIPELINE (LangGraph) ──────────────────────────────────────
LAYER0_ENABLED=true
LAYER2_ENABLED=true
LAYER2_ENABLED_SOURCES=facebook,linkedin,website
LAYER2_MAX_URLS_PER_SOURCE=2
LAYER2_TIMEOUT_SEC=30

# ── 📝 LOGGING & RECOVERY ────────────────────────────────────────────────
LOG_LEVEL=INFO
REPROCESS_FAILED_ROWS=true

# ── 🛡️ PROXY CONFIGURATION ──────────────────────────────────────────────
# Leave RESIDENTIAL_PROXIES commented out to use the FREE proxy fallback system.
# Uncomment and populate when you have premium proxies.
# Format: username:password@host:port (comma separated)
# RESIDENTIAL_PROXIES="user:pass@host1:port1,user:pass@host2:port2"
PROXY_ENABLED=false

# ── 🌐 NETWORK SPEED ──────────────────────────────────────────────
# Timeout multiplier for adaptive tier timeouts
# 1.0=normal | 1.5=slow | 2.5=bad connection
# Adjusted dynamically by NetworkSpeedProbe at runtime.
NETWORK_SPEED_MULTIPLIER=1.0